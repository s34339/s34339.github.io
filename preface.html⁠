<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>preface.html | Portfolio</title>
<style>
/* ===== RESET ===== */
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0; min-height: 100vh; font-family: Tahoma, Arial, sans-serif; color: #3f5a35; position: relative;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(255,255,255,.85), transparent 38%),
    radial-gradient(circle at 15% 30%, rgba(255,214,236,.55), transparent 30%),
    radial-gradient(circle at 85% 20%, rgba(200,240,170,.55), transparent 32%),
    radial-gradient(circle at 25% 80%, rgba(255,200,230,.4), transparent 30%),
    radial-gradient(circle at 80% 75%, rgba(190,235,160,.45), transparent 32%),
    linear-gradient(180deg, #fff6e9 0%, #ffe9f2 22%, #eafcd8 55%, #d6f5c4 80%, #bdeeae 100%);
  display: flex; align-items: center; justify-content: center; padding: 40px 0; overflow-x: hidden;
}
body .garden-sun{position:fixed;width:220px;height:220px;border-radius:50%;top:-80px;right:-60px;z-index:0;pointer-events:none;
  background:radial-gradient(circle, #fff6c8 0%, #ffe98a 55%, transparent 75%);box-shadow:0 0 60px rgba(255,222,120,.55);
  animation:sunPulse 6s ease-in-out infinite;}
@keyframes sunPulse{0%,100%{opacity:.75;transform:scale(1)}50%{opacity:1;transform:scale(1.08)}}
body .garden-grass{position:fixed;left:0;right:0;bottom:0;height:70px;z-index:1;pointer-events:none;opacity:.5;
  background:repeating-linear-gradient(75deg, #9fdb7a 0 10px, #b6e893 10px 20px);
  -webkit-mask-image:repeating-conic-gradient(from 0deg,#000 0deg 8deg,transparent 8deg 16deg);
  mask-image:repeating-conic-gradient(from 0deg,#000 0deg 8deg,transparent 8deg 16deg);}
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: .55;
  background:
    linear-gradient(110deg, transparent 15%, rgba(255,255,255,.35) 30%, transparent 42%),
    linear-gradient(70deg, transparent 30%, rgba(255,225,245,.3) 45%, transparent 58%),
    linear-gradient(100deg, transparent 50%, rgba(210,240,175,.3) 65%, transparent 78%);
  background-size: 250% 100%, 220% 100%, 250% 100%;
  animation: sparkleShift 10s ease-in-out infinite alternate;
}
@keyframes sparkleShift { 0%{transform:translateX(-50px);opacity:.3} 50%{transform:translateX(20px);opacity:.6} 100%{transform:translateX(60px);opacity:.85} }

/* ===== SPARKLE / DECOR ===== */
.glitter { position:fixed; width:4px; height:4px; border-radius:50%; background:white; z-index:2; pointer-events:none;
  box-shadow:0 0 5px white,0 0 12px #ffc6e6,0 0 20px #c9eda0; animation:glitterMove 4s ease-in-out infinite, glitterBlink 1.5s ease-in-out infinite alternate; }
@keyframes glitterMove { 0%,100%{transform:translateY(20px)} 50%{transform:translateY(-40px)} }
@keyframes glitterBlink { 0%{opacity:.2;transform:scale(.5)} 100%{opacity:1;transform:scale(1.5)} }

.diamond { position:fixed; width:22px; height:22px; transform:rotate(45deg); border-radius:4px; z-index:3; pointer-events:none;
  background:linear-gradient(135deg,white 0%,#ffd6ec 25%,#c9eda0 45%,white 65%,#ffc2e2 85%,white 100%);
  box-shadow:0 0 8px white,0 0 18px #ffcce8,0 0 35px #c9eda0;
  animation:diamondFloat 6s ease-in-out infinite, diamondGlow 2s ease-in-out infinite alternate; }
.diamond.small{width:12px;height:12px;} .diamond.big{width:32px;height:32px;}
@keyframes diamondFloat{0%{transform:translateY(30px) rotate(45deg)}50%{transform:translateY(-70px) rotate(135deg)}100%{transform:translateY(30px) rotate(225deg)}}
@keyframes diamondGlow{from{opacity:.3;filter:brightness(.8)}to{opacity:1;filter:brightness(1.8)}}
.d1{left:6%;top:20%} .d2{left:18%;top:70%;animation-delay:1s} .d3{left:30%;top:15%;animation-delay:2s}
.d4{right:8%;top:20%;animation-delay:1.5s} .d5{right:17%;top:65%;animation-delay:3s} .d6{left:50%;top:80%;animation-delay:2.5s}

.bubble { position:fixed; bottom:-60px; width:20px; height:20px; border-radius:50%; border:2px solid rgba(255,255,255,.8);
  background:rgba(255,255,255,.12); z-index:2; pointer-events:none;
  box-shadow:inset 2px 2px 5px white,0 0 10px rgba(255,200,230,.6); animation:bubbleUp 9s linear infinite; }
@keyframes bubbleUp{0%{transform:translateY(0) translateX(0) scale(.7);opacity:0}15%{opacity:.8}
  50%{transform:translateY(-50vh) translateX(35px) scale(1)}100%{transform:translateY(-115vh) translateX(-30px) scale(1.2);opacity:0}}
.b1{left:7%} .b2{left:20%;animation-delay:3s;width:12px;height:12px} .b3{left:35%;animation-delay:5s;width:28px;height:28px}
.b4{left:55%;animation-delay:2s} .b5{left:70%;animation-delay:6s;width:13px;height:13px} .b6{left:85%;animation-delay:4s;width:25px;height:25px}

.wave { position:fixed; left:-15%; bottom:-120px; width:130%; height:300px; border-radius:50% 50% 0 0; z-index:4; pointer-events:none;
  background:linear-gradient(180deg, rgba(255,214,236,.6), rgba(255,170,215,.7));
  box-shadow:0 -20px 50px rgba(255,200,230,.4); animation:waveMove 5s ease-in-out infinite; }
.wave.two{bottom:-155px;height:320px;opacity:.7;background:linear-gradient(180deg,rgba(200,235,150,.55),rgba(150,210,110,.6));animation:waveMove 7s ease-in-out infinite reverse}
.wave.three{bottom:-200px;height:350px;opacity:.5;background:rgba(255,205,232,.6);animation:waveMove 9s ease-in-out infinite}
@keyframes waveMove{0%,100%{transform:translateX(-5%) rotate(1deg)}50%{transform:translateX(5%) rotate(-2deg)}}

.shimmer-overlay { position:fixed; inset:0; z-index:1; pointer-events:none; opacity:.8;
  background-image:radial-gradient(circle, rgba(255,255,255,.9) 1px, transparent 1.4px),
    radial-gradient(circle, rgba(255,214,236,.8) 1px, transparent 1.4px),
    radial-gradient(circle, rgba(200,235,165,.8) 1px, transparent 1.4px);
  background-size:90px 90px,130px 130px,160px 160px; background-position:0 0,30px 60px,70px 20px;
  animation:shimmerDrift 9s linear infinite; }
@keyframes shimmerDrift{0%{background-position:0 0,30px 60px,70px 20px}100%{background-position:90px 90px,-100px 190px,-90px 180px}}

.star-sparkle{position:fixed;z-index:2;pointer-events:none;color:white;line-height:1;
  text-shadow:0 0 6px white,0 0 14px #ffd6ec,0 0 22px #c9eda0;
  animation:starTwinkle 2.6s ease-in-out infinite, starSpin 7s linear infinite;}
@keyframes starTwinkle{0%,100%{opacity:.25;transform:scale(.6)}50%{opacity:1;transform:scale(1.25)}}
@keyframes starSpin{from{filter:hue-rotate(0deg)}to{filter:hue-rotate(25deg)}}

.floaty-sticker{position:fixed;z-index:2;pointer-events:none;line-height:1;opacity:.9;
  filter:drop-shadow(0 0 6px rgba(255,255,255,.9)) drop-shadow(0 0 12px rgba(255,214,236,.6));
  animation:stickerFloat 8s ease-in-out infinite;}
@keyframes stickerFloat{0%{transform:translateY(0) translateX(0) rotate(-6deg)}25%{transform:translateY(-18px) translateX(10px) rotate(4deg)}
  50%{transform:translateY(6px) translateX(-8px) rotate(-4deg)}75%{transform:translateY(-12px) translateX(6px) rotate(6deg)}100%{transform:translateY(0) translateX(0) rotate(-6deg)}}

.emoji-fall{position:fixed;top:-8%;z-index:3;line-height:1;pointer-events:none;
  filter:drop-shadow(0 0 6px rgba(255,255,255,.9)) drop-shadow(0 0 10px rgba(255,214,236,.6));
  animation-name:emojiFallA;animation-timing-function:linear;animation-iteration-count:infinite;}
.emoji-fall.sway-b{animation-name:emojiFallB} .emoji-fall.sway-c{animation-name:emojiFallC}
@keyframes emojiFallA{0%{transform:translateY(-10vh) translateX(0) rotate(0deg);opacity:0}8%{opacity:.95}
  50%{transform:translateY(55vh) translateX(35px) rotate(180deg)}92%{opacity:.95}100%{transform:translateY(115vh) translateX(-15px) rotate(360deg);opacity:0}}
@keyframes emojiFallB{0%{transform:translateY(-10vh) translateX(0) rotate(0deg);opacity:0}8%{opacity:.95}
  50%{transform:translateY(55vh) translateX(-40px) rotate(-180deg)}92%{opacity:.95}100%{transform:translateY(115vh) translateX(20px) rotate(-360deg);opacity:0}}
@keyframes emojiFallC{0%{transform:translateY(-10vh) translateX(0) rotate(0deg);opacity:0}8%{opacity:.9}
  25%{transform:translateY(20vh) translateX(28px) rotate(90deg)}50%{transform:translateY(55vh) translateX(-24px) rotate(180deg)}
  75%{transform:translateY(85vh) translateX(24px) rotate(270deg)}92%{opacity:.9}100%{transform:translateY(115vh) translateX(-10px) rotate(360deg);opacity:0}}

/* ===== LAYOUT ===== */
.page-card{position:relative;z-index:10;width:min(1050px,92%);text-align:left;
  background:linear-gradient(145deg, rgba(255,255,255,.96), rgba(255,240,248,.94));
  border:4px solid white;box-shadow:0 30px 80px rgba(120,150,80,.3),0 0 40px rgba(255,255,255,.6);backdrop-filter:blur(12px);
  padding:50px 40px;min-height:480px;border-radius:45px;
  animation:cardGlowPulse 3.2s ease-in-out infinite;}

h2.page-title{margin:0 0 30px;font-size:clamp(30px,6vw,46px);color:#ff8fc2;letter-spacing:2px;text-align:center;
  text-shadow:2px 2px white,0 0 16px rgba(160,220,120,.5);}

.quote-card{position:relative;padding:34px 36px;border-radius:30px;background:rgba(255,255,255,.75);border:2px solid #ffd6ec;
  box-shadow:0 8px 24px rgba(255,190,220,.3);line-height:2;font-size:16px;text-align:justify;color:#3f5a35;}
.quote-card .quote-mark{display:block;font-size:42px;line-height:1;color:#ffb6d9;margin-bottom:6px;}

@keyframes cardGlowPulse{
  0%,100%{box-shadow:0 30px 80px rgba(120,150,80,.3),0 0 40px rgba(255,255,255,.65),0 0 55px rgba(255,182,217,.5);}
  50%{box-shadow:0 30px 90px rgba(120,150,80,.35),0 0 65px rgba(255,255,255,.95),0 0 95px rgba(200,235,165,.75);}
}

/* ===== SPARKLE CURSOR TRAIL ===== */
.cursor-sparkle{position:fixed;z-index:260;pointer-events:none;font-size:16px;line-height:1;
  animation:cursorSparkleFade .8s ease-out forwards;}
@keyframes cursorSparkleFade{
  0%{transform:translate(-50%,-50%) scale(0.4) rotate(0deg);opacity:1;}
  100%{transform:translate(-50%,-50%) scale(1.3) rotate(120deg) translateY(-24px);opacity:0;}
}

@media(max-width:600px){
  .page-card{padding:45px 18px;}
}
</style>
</head>
<body>

<div class="garden-sun"></div>
<div class="garden-grass"></div>

<div class="glitter g1" style="left:5%;top:18%"></div>
<div class="glitter g2" style="left:18%;top:25%;animation-delay:.8s"></div>
<div class="glitter g3" style="left:39%;top:82%;animation-delay:1.7s"></div>
<div class="glitter g4" style="left:59%;top:30%;animation-delay:.2s"></div>
<div class="glitter g5" style="left:79%;top:48%;animation-delay:1.3s"></div>
<div class="glitter g6" style="left:92%;top:65%;animation-delay:1.6s"></div>

<div class="diamond d1"></div>
<div class="diamond small d2"></div>
<div class="diamond d3"></div>
<div class="diamond big d4"></div>

<div class="bubble b1"></div>
<div class="bubble b2"></div>
<div class="bubble b3"></div>
<div class="bubble b4"></div>

<div class="wave"></div>
<div class="wave two"></div>
<div class="wave three"></div>

<div class="shimmer-overlay"></div>

<span class="emoji-fall sway-b" style="left:67%;font-size:28px;animation-delay:.8s;animation-duration:8.3s">🌷</span>
<span class="emoji-fall sway-c" style="left:19%;font-size:24px;animation-delay:2s;animation-duration:7s">🍀</span>
<span class="emoji-fall" style="left:15%;font-size:24px;animation-delay:3s;animation-duration:11s">🌼</span>
<span class="emoji-fall sway-c" style="left:75%;font-size:32px;animation-delay:1s;animation-duration:7.2s">🌸</span>

<span class="floaty-sticker" style="left:89%;top:40%;font-size:26px;animation-delay:.3s">🎀</span>
<span class="floaty-sticker" style="left:24%;top:54%;font-size:26px;animation-delay:3.3s">🌸</span>

<span class="star-sparkle" style="left:73%;top:54%;font-size:16px;animation-delay:2.3s">✦</span>
<span class="star-sparkle" style="left:25%;top:56%;font-size:28px;animation-delay:.2s">✦</span>

<div class="page-card">
  <h2 class="page-title">คำนำ (PREFACE)</h2>
  <div class="quote-card">
    <span class="quote-mark">❝</span>
    แฟ้มสะสมผลงาน (Portfolio) เล่มนี้จัดทำขึ้นเพื่อรวบรวมประวัติส่วนตัว
    ผลการศึกษา กิจกรรม ผลงาน และประสบการณ์ต่าง ๆ ที่สะท้อนถึงความสนใจ
    ความตั้งใจ และความมุ่งมั่นของข้าพเจ้าเพื่อใช้ในการศึกษาต่อในคณะแพทยศาสตร์
    ข้าพเจ้ามีความสนใจด้านวิทยาศาสตร์และการแพทย์ รวมถึงมีความตั้งใจ
    ที่จะนำความรู้และความสามารถที่ได้รับไปใช้ในการดูแลและช่วยเหลือผู้อื่น
    <br><br>
    ตลอดระยะเวลาที่ผ่านมา ข้าพเจ้าได้พยายามเรียนรู้และพัฒนาตนเองทั้งด้าน
    วิชาการ การทำงานร่วมกับผู้อื่น ความรับผิดชอบ และการทำกิจกรรมต่าง ๆ
    โดยทุกประสบการณ์ล้วนเป็นส่วนสำคัญที่ทำให้ข้าพเจ้าได้เรียนรู้ถึงคุณค่า
    ของการเสียสละ การมีน้ำใจ และการช่วยเหลือผู้อื่น ซึ่งเป็นคุณสมบัติที่
    ข้าพเจ้าเชื่อว่ามีความสำคัญต่อการเป็นแพทย์ที่ดี
    <br><br>
    ข้าพเจ้าหวังว่าแฟ้มสะสมผลงานเล่มนี้จะช่วยสะท้อนตัวตน ความสามารถ
    และความตั้งใจจริงในการก้าวเข้าสู่เส้นทางวิชาชีพแพทย์ และเป็นส่วนหนึ่ง
    ที่แสดงให้เห็นถึงความพร้อมในการเรียนรู้และพัฒนาตนเองต่อไปในอนาคต
    <br><br>
    ข้าพเจ้าขอขอบพระคุณครู ผู้ปกครอง และทุกท่านที่ให้การสนับสนุน
    ส่งเสริม และเป็นกำลังใจตลอดเส้นทางการเรียนรู้ของข้าพเจ้า
  </div>
</div>

<script>
  /* ===== SPARKLE ตามเมาส์ ===== */
  const sparkleChars = ['✦','✨','🌷','⭐'];
  let lastSparkleTime = 0;
  document.addEventListener('mousemove', (e) => {
    const now = Date.now();
    if(now - lastSparkleTime < 180) return;
    lastSparkleTime = now;
    const s = document.createElement('span');
    s.className = 'cursor-sparkle';
    s.textContent = sparkleChars[Math.floor(Math.random()*sparkleChars.length)];
    s.style.left = e.clientX + 'px';
    s.style.top = e.clientY + 'px';
    s.style.color = Math.random() > 0.5 ? '#ff8fc2' : '#5a9a45';
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 820);
  });
</script>

</body>
</html>
